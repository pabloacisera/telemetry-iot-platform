# ===========================================================
# Docker Compose environment variables
# Copy this file to .env and fill in real values
# ===========================================================

# MySQL
MYSQL_ROOT_PASSWORD=root_dev_pass
MYSQL_DATABASE=telemetry_db
MYSQL_USER=telemetry_user
MYSQL_PASSWORD=telemetry_dev_pass

# MQTT (broker credentials for the backend service)
MQTT_BACKEND_USER=backend_service
MQTT_BACKEND_PASS=backend_dev_pass

# JWT
JWT_SECRET=change_me_in_production
JWT_EXPIRES_IN=15m

# RAG (spec 05)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2
RAG_SIMILARITY_THRESHOLD=0.65

# Grafana
GRAFANA_ADMIN_PASSWORD=admin

# Simulator (MQTT credentials are in mosquitto/password_file)
# No additional env vars needed — it reads from the broker config
