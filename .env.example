# ===========================================================
# Environment variables — single source of truth for all services
# Copy to .env and fill in real values
# ===========================================================

# MySQL
MYSQL_ROOT_PASSWORD=root_dev_pass
MYSQL_DATABASE=telemetry_db
MYSQL_USER=telemetry_user
MYSQL_PASSWORD=telemetry_dev_pass

# Database URL (used by Prisma when running outside Docker)
# Inside Docker, docker-compose.yml overrides this with container hostnames
DATABASE_URL=mysql://telemetry_user:telemetry_dev_pass@localhost:3306/telemetry_db

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# MQTT
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_BACKEND_USER=backend_service
MQTT_BACKEND_PASS=backend_dev_pass

# JWT
JWT_SECRET=change_me_in_production
JWT_EXPIRES_IN=15m

# RAG
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2
RAG_SIMILARITY_THRESHOLD=0.65

# Landing / demo access (self-service signup from the public landing page)
# Resend API key for transactional email (https://resend.com). Leave empty to
# skip sending (users are still created).
RESEND_API_KEY=
# Sender shown in welcome emails. Sandbox onboarding@resend.dev only delivers to
# the verified email in your Resend account; use a verified domain in production.
RESEND_FROM=onboarding@resend.dev
# Role assigned to accounts created from the landing: viewer | operator | admin
LANDING_DEMO_ROLE=viewer
# Base URL used in the welcome email CTA ("Ingresar")
LANDING_APP_URL=http://localhost:5173

# Grafana
GRAFANA_ADMIN_PASSWORD=admin
# URL de acceso directo a Grafana desde el header (inyectada en build del frontend).
# En local apunta a http://localhost:3001/grafana/.
# En producción (ansible/files/.env.production) DEBE apuntar al subdominio:
#   VITE_GRAFANA_URL=https://<dominio>/grafana/  y  GF_SERVER_ROOT_URL=https://<dominio>/grafana/
VITE_GRAFANA_URL=http://localhost:3001/grafana/
GF_SERVER_ROOT_URL=http://localhost:3001/grafana/

# Retention
RETENTION_DAYS=7
# Días que se conservan las alertas RESUELTAS antes de purgarlas (activas nunca se borran)
ALERT_RETENTION_DAYS=30

# Alert anti-flood
# Ventana (ms) durante la cual no se re-crea una alerta del MISMO tipo para el MISMO
# motor, aunque la anterior ya se haya auto-resuelto al volver a healthy. Evita el
# flood de alertas cuando un motor entra en ciclos rápidos trip → restart → healthy.
# Default: 300000 (5 min)
ALERT_THROTTLE_MS=300000
# Piso (ms) del cooldown post-reinicio. Un motor no puede trip nuevamente dentro de
# esta ventana tras un restart (durante el cooldown se exige el doble de lecturas).
# Se aplica el máximo entre este piso y el valor configurado por motor, de modo que
# valores per-motor menores quedan pisados. Default: 300000 (5 min)
POST_RESTART_COOLDOWN_MS=300000
