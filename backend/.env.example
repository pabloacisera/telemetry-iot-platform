# Database (MySQL)
DATABASE_URL="mysql://root:root_dev_pass@localhost:3306/telemetry_db"

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# MQTT Broker
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
