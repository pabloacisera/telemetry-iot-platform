# Production .env — DO NOT commit with real values.
# This file is copied by Ansible to the EC2. Fill in before deploying.

MYSQL_ROOT_PASSWORD=<CHANGE_ME>
MYSQL_DATABASE=telemetry_db
MYSQL_USER=telemetry_user
MYSQL_PASSWORD=<CHANGE_ME>

MQTT_BACKEND_USER=backend_service
MQTT_BACKEND_PASS=<CHANGE_ME>

JWT_SECRET=<CHANGE_ME_LONG_RANDOM_STRING>
JWT_EXPIRES_IN=15m

GROQ_API_KEY=<YOUR_GROQ_API_KEY>
GROQ_MODEL=llama-3.3-70b-versatile
EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2
RAG_SIMILARITY_THRESHOLD=0.65

GRAFANA_ADMIN_PASSWORD=<CHANGE_ME>
