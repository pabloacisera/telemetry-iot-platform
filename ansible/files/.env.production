# Production .env — mismo esquema de credenciales que en local/dev.
# Copiado por Ansible a la EC2 (deploy-app.yml -> files/.env.production -> /opt/apps/<app>/.env).
# MQTT: las credenciales DEBEN coincidir con mosquitto/password_file (generado con generate_passwords.py).
# GROQ_API_KEY: completar antes de desplegar.

MYSQL_ROOT_PASSWORD=root_dev_pass
MYSQL_DATABASE=telemetry_db
MYSQL_USER=telemetry_user
MYSQL_PASSWORD=telemetry_dev_pass

MQTT_BACKEND_USER=backend_service
MQTT_BACKEND_PASS=backend_dev_pass

JWT_SECRET=dev_secret_not_for_production_change_me
JWT_EXPIRES_IN=15m

GROQ_API_KEY=<YOUR_GROQ_API_KEY>
GROQ_MODEL=llama-3.3-70b-versatile
EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2
RAG_SIMILARITY_THRESHOLD=0.65

# Grafana — en producción el acceso es por subdominio (nginx-global expone /grafana/).
# IMPORTANTE: VITE_GRAFANA_URL se inyecta en el build del frontend (ARG del Dockerfile).
# Si cambia y la imagen del frontend ya existe en la EC2, forzar rebuild:
#   docker compose build frontend  (o borrar la imagen del frontend antes de redeployar).
GRAFANA_ADMIN_PASSWORD=admin
VITE_GRAFANA_URL=https://telemetry.artisandevs.site/grafana/
GF_SERVER_ROOT_URL=https://telemetry.artisandevs.site/grafana/

# Retention
RETENTION_DAYS=7
ALERT_RETENTION_DAYS=30